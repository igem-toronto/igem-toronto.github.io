---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';

const mailingListUrl =
  'https://docs.google.com/forms/d/e/1FAIpQLSf-KSquSPZU7TA7cn8uHiyXQrtfFgUsrA-pOTJUwozIr7L5TA/viewform';

const divisions = [
  {
    name: 'Wet Lab',
    tag: 'Experimental',
    description:
      'The heart of scientific exploration. Scientists and bioengineers conduct hands-on experiments, perfect protocols, and bring biological projects to life at the bench.',
  },
  {
    name: 'Dry Lab',
    tag: 'Computational',
    description:
      'The digital frontier of synthetic biology — analyzing data, modelling complex systems, and applying bioinformatics tools to guide experimental design.',
  },
  {
    name: 'Hardware',
    tag: 'Engineering',
    description:
      'Where biology meets technology. Electronics and hardware development produce custom instrumentation for synthetic biology projects.',
  },
  {
    name: 'Human Practices',
    tag: 'Ethics & society',
    description:
      'The ethical, social, and cultural dimensions of synthetic biology. Engaging stakeholders, researching societal implications, and integrating responsible practices into design.',
  },
  {
    name: 'Entrepreneurship',
    tag: 'Business',
    description:
      'Bridging science and business. Identifying market opportunities, developing business plans, and exploring funding strategies to turn projects into impactful ventures.',
  },
  {
    name: 'Outreach',
    tag: 'Communication',
    description:
      'Sharing synthetic biology with the community through educational programs, engagement with schools and organizations, and public science communication.',
  },
  {
    name: 'Finance',
    tag: 'Operations',
    description:
      'Sustaining the team through budgeting, financial strategy, and fundraising — a vital role behind every initiative iGEM Toronto undertakes.',
  },
];
---

<BaseLayout title="Divisions" description="The divisions that make up iGEM Toronto.">
  <PageHeader
    eyebrow="Structure"
    title="Divisions"
    lede="Each division contributes a distinct set of skills and expertise. Together they drive the success of our projects."
  />

  <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
    <div class="border-t border-primary-950/15">
      {
        divisions.map((division, i) => (
          <div class="grid gap-4 border-b border-primary-950/15 py-8 md:grid-cols-12 md:gap-8">
            <div class="flex items-baseline gap-4 md:col-span-4">
              <span class="font-display text-sm font-semibold tabular-nums text-accent-orange">
                {String(i + 1).padStart(2, '0')}
              </span>
              <div>
                <h2 class="font-display text-xl font-bold tracking-tight text-primary-950">{division.name}</h2>
                <p class="mt-1 text-xs uppercase tracking-[0.15em] text-primary-950/45">{division.tag}</p>
              </div>
            </div>
            <p class="leading-relaxed text-primary-950/70 md:col-span-8">{division.description}</p>
          </div>
        ))
      }
    </div>

    <div class="mt-14 flex flex-col items-start justify-between gap-6 border border-primary-950 bg-primary-950 px-8 py-10 md:flex-row md:items-center">
      <div>
        <h2 class="font-display text-2xl font-bold tracking-tight text-white">Find your place</h2>
        <p class="mt-2 max-w-xl text-white/60">
          Lab experiments, computation, hardware, ethics, business, outreach, or finance — there is a place for you.
        </p>
      </div>
      <a
        href={mailingListUrl}
        class="shrink-0 border border-accent-orange bg-accent-orange px-7 py-3 text-sm font-semibold uppercase tracking-widest text-white transition-colors hover:bg-transparent"
      >
        Join Us
      </a>
    </div>
  </section>
</BaseLayout>
