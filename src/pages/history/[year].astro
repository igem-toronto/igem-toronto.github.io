---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import PhotoStrip from '../../components/PhotoStrip.astro';
import {
  allSeasons,
  base,
  medalClass,
  medalLabel,
  neighbours,
  photosFor,
  projectLabel,
  seasonUrl,
  type Season,
} from '../../lib/history';

export function getStaticPaths() {
  return allSeasons.map((season) => ({
    params: { year: String(season.year) },
    props: { season },
  }));
}

const { season } = Astro.props as { season: Season };

const photoTotal = photosFor(season.year).length;
const galleryAnchorUrl = `${base}/gallery/#year-${season.year}`;
const { previous, next } = neighbours(season.year);

const facts = [
  { label: 'Team size', value: `${season.teamSize} members` },
  { label: 'Track', value: season.track ?? 'Not recorded' },
  { label: 'Section', value: season.section === 'overgrad' ? 'Overgraduate' : season.section === 'undergrad' ? 'Undergraduate' : 'Not recorded' },
  { label: 'Competed as', value: season.nickname ?? season.teamName },
];

const videoRoleLabel = { promo: 'Project Promotion', presentation: 'Team Presentation', other: 'Video' };
---

<BaseLayout
  title={`${season.year}`}
  description={`iGEM Toronto ${season.year}: ${projectLabel(season)}. ${medalLabel(season)}.`}
>
  <!-- Hero -->
  <section class="border-b border-primary-950/15 bg-primary-950">
    <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
      <a
        href={`${base}/history/`}
        class="inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-[0.25em] text-accent-orange-light transition-colors hover:text-white"
      >
        <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
          <path stroke-linecap="square" d="M19 12H5M11 18l-6-6 6-6" />
        </svg>
        All years
      </a>

      <h1 class="mt-6 font-display text-6xl font-bold tabular-nums tracking-tight text-white sm:text-7xl">
        {season.year}
      </h1>
      <p class="mt-4 max-w-3xl font-display text-2xl font-medium leading-snug text-white sm:text-3xl">
        {projectLabel(season)}
      </p>

      <div class="mt-7 flex flex-wrap items-center gap-2">
        <span
          class:list={[
            'border px-3 py-1.5 text-xs font-semibold uppercase tracking-[0.15em]',
            season.medal
              ? medalClass(season.medal)
              : 'border-white/25 bg-white/5 text-white/60',
          ]}
        >
          {medalLabel(season)}
        </span>
        {
          season.track && (
            <span class="border border-white/25 px-3 py-1.5 text-xs font-semibold uppercase tracking-[0.15em] text-white/60">
              {season.track}
            </span>
          )
        }
      </div>
    </div>
  </section>

  <!-- Facts -->
  <section class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-2 divide-x divide-y divide-primary-950/10 border-x border-b border-primary-950/10 sm:grid-cols-4 sm:divide-y-0">
      {
        facts.map((fact) => (
          <div class="px-5 py-6">
            <div class="text-xs font-medium uppercase tracking-[0.15em] text-primary-950/45">{fact.label}</div>
            <div class="mt-2 font-display font-bold text-primary-950">{fact.value}</div>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Wiki -->
  <section class="mx-auto max-w-7xl px-4 pt-10 sm:px-6 lg:px-8">
    <a
      href={season.wikiUrl}
      class="flex flex-col items-start justify-between gap-6 border border-primary-950 bg-primary-950 px-8 py-8 transition-colors hover:bg-primary-950/90 sm:flex-row sm:items-center"
    >
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.25em] text-accent-orange-light">Full writeup</p>
        <h2 class="mt-2 font-display text-2xl font-bold tracking-tight text-white">The {season.year} wiki</h2>
      </div>
      <span class="inline-flex shrink-0 items-center gap-3 border border-accent-orange bg-accent-orange px-8 py-4 text-sm font-semibold uppercase tracking-widest text-white transition-colors group-hover:bg-transparent">
        Read the wiki
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="square" d="M5 12h14M13 6l6 6-6 6" />
        </svg>
      </span>
    </a>
  </section>

  {
    season.videos && season.videos.length > 0 && (
      <section class="border-y border-primary-950/15 bg-primary-50">
        <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
          <SectionHeading title="Watch" eyebrow="From the iGEM Video Universe" number="01" />
          <div class:list={['grid gap-8', season.videos.length > 1 ? 'md:grid-cols-2' : '']}>
            {season.videos.map((video) => (
              <div>
                <div class="aspect-video w-full overflow-hidden border border-primary-950/15 bg-primary-950">
                  <iframe
                    src={video.embedUrl}
                    title={video.title}
                    class="h-full w-full"
                    frameborder="0"
                    allowfullscreen
                    loading="lazy"
                  />
                </div>
                <p class="mt-3 text-xs font-semibold uppercase tracking-[0.15em] text-accent-orange">
                  {videoRoleLabel[video.role]}
                </p>
                <p class="mt-1 text-sm text-primary-950/70">{video.title}</p>
              </div>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- Story + awards -->
  <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
    <div class="grid gap-x-16 gap-y-10 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <SectionHeading title="The year" eyebrow="What happened" number="02" />
        <p class="text-lg leading-relaxed text-primary-950/80">{season.story}</p>

        {
          season.note && (
            <p class="mt-6 border-l-2 border-accent-orange bg-primary-50 px-4 py-3 text-sm leading-relaxed text-primary-950/65">
              {season.note}
            </p>
          )
        }

        <div class="mt-8 flex flex-wrap gap-x-8 gap-y-3">
          <a
            href={season.teamsUrl}
            class="inline-flex items-center gap-2 border-b border-primary-950/25 pb-0.5 text-sm font-semibold uppercase tracking-widest text-primary-950/60 transition-colors hover:border-primary-950 hover:text-primary-950"
          >
            iGEM team page
          </a>
        </div>
      </div>

      <div class="lg:col-span-5">
        <SectionHeading title="Awards" eyebrow="Results" number="03" />
        {
          season.awards.length > 0 ? (
            <ul>
              {season.awards.map((award) => (
                <li class="flex items-baseline gap-3 border-b border-primary-950/10 py-3 text-primary-950/80">
                  <span class="text-accent-orange">&#8226;</span>
                  {award}
                </li>
              ))}
            </ul>
          ) : (
            <p class="text-sm leading-relaxed text-primary-950/50">
              {season.medal
                ? `A ${season.medal.toLowerCase()} medal, with no special prizes recorded.`
                : 'No awards are recorded for this year. See the note on the left for why that may be a gap in the record rather than a result.'}
            </p>
          )
        }
      </div>
    </div>
  </section>

  <!-- Photographs -->
  <section class="border-y border-primary-950/15 bg-primary-50">
    <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
      <SectionHeading title="Photographs" eyebrow="Gallery" number="04" />
      {
        photoTotal > 0 ? (
          <>
            <div class="max-w-2xl">
              <PhotoStrip year={season.year} limit={Math.min(6, photoTotal)} linkUrl={galleryAnchorUrl} />
            </div>
            <a
              href={galleryAnchorUrl}
              class="mt-8 inline-flex items-center gap-3 border border-accent-orange bg-accent-orange px-8 py-4 text-sm font-semibold uppercase tracking-widest text-white transition-colors hover:bg-transparent hover:text-accent-orange"
            >
              See all {photoTotal} photos from {season.year} in the Gallery
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="square" d="M5 12h14M13 6l6 6-6 6" />
              </svg>
            </a>
          </>
        ) : (
          <p class="max-w-md text-sm leading-relaxed text-primary-950/50">
            Nothing from this year has been recovered yet. If you have photographs — lab work, the
            Jamboree, outreach, socials — they belong in the{' '}
            <a href={`${base}/gallery/`} class="text-accent-orange underline decoration-accent-orange/40 underline-offset-4 hover:text-primary-950">
              Gallery
            </a>.
          </p>
        )
      }
    </div>
  </section>

  <!-- Prev / next -->
  <section class="mx-auto max-w-7xl px-4 py-14 sm:px-6 lg:px-8">
    <div class="flex flex-col gap-4 sm:flex-row sm:justify-between">
      {
        previous ? (
          <a href={seasonUrl(previous.year)} class="group max-w-sm">
            <span class="text-xs font-semibold uppercase tracking-[0.2em] text-primary-950/40">Previous year</span>
            <span class="mt-2 block font-display text-xl font-bold text-primary-950 group-hover:text-accent-orange">
              {previous.year} — {projectLabel(previous)}
            </span>
          </a>
        ) : (
          <span />
        )
      }
      {
        next && (
          <a href={seasonUrl(next.year)} class="group max-w-sm sm:text-right">
            <span class="text-xs font-semibold uppercase tracking-[0.2em] text-primary-950/40">Next year</span>
            <span class="mt-2 block font-display text-xl font-bold text-primary-950 group-hover:text-accent-orange">
              {next.year} — {projectLabel(next)}
            </span>
          </a>
        )
      }
    </div>
  </section>
</BaseLayout>
