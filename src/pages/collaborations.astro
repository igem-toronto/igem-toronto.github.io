---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';

const cdn = 'https://static.igem.wiki/teams/4615/wiki/';

// NOTE FOR MAINTAINERS: these are the 2023 collaborations carried over from the
// old site. Add new entries to the top of this list as the team attends new
// events — each entry just needs a title, description, and one or more image
// URLs (upload photos via https://uploads.igem.org).
const collaborations = [
  {
    title: 'Biozone CO2 Conference',
    date: 'June 2023',
    description:
      'iGEM Toronto presented at the CO2 Conference organized by Biozone at the University of Toronto.',
    images: [
      { src: `${cdn}hpphoto/biozone-co2-conference-0.jpg`, alt: 'iGEM Toronto presenting at the Biozone CO2 Conference' },
    ],
  },
  {
    title: 'Publishing on The Cannon',
    date: 'October 2023',
    description:
      'iGEM Toronto collaborated with The Cannon — the engineering magazine at the University of Toronto — to publish an article about landfill gas emissions in the October 2023 edition.',
    images: [{ src: `${cdn}hpphoto/20231008-105900.jpg`, alt: 'The Cannon article by iGEM Toronto' }],
  },
  {
    title: "Club's Fair",
    date: 'September 2023',
    description: "iGEM Toronto spoke to new UofT students at the Fall Club's Fair.",
    images: [
      { src: `${cdn}hpphoto/20230906-164626.jpg`, alt: "iGEM Toronto speaking to new UofT students at the Fall Club's Fair" },
    ],
  },
  {
    title: 'In Vitro Conference',
    date: 'August 2023',
    description:
      'Organized by iGEM McGill, iGEM Toronto attended and presented our project and results at the In Vitro Conference.',
    images: [
      { src: `${cdn}hpphoto/20230827-154600.jpg`, alt: 'iGEM Toronto at the In Vitro Conference' },
      { src: `${cdn}hpphoto/20230827-154412.jpg`, alt: 'Presentation at the In Vitro Conference' },
      { src: `${cdn}hpphoto/20230827-155857.jpg`, alt: 'iGEM Toronto presenting results at the In Vitro Conference' },
    ],
  },
];
---

<BaseLayout title="Collaborations" description="Conferences and collaborations iGEM Toronto has taken part in.">
  <PageHeader
    eyebrow="Engagement"
    title="Collaborations"
    lede="iGEM Toronto is invited to conferences throughout the iGEM cycle to present our project and connect with professionals."
  />

  <!-- TODO (human): the events below are from the 2023 cycle. Add this year's
       collaborations to the list at the top of this file's frontmatter. -->
  <section class="mx-auto max-w-5xl px-4 py-16 sm:px-6 lg:px-8">
    <div class="border-t border-primary-950/15">
      {
        collaborations.map((collab, i) => (
          <article class="grid gap-8 border-b border-primary-950/15 py-12 lg:grid-cols-12">
            <div class="lg:col-span-5">
              {collab.images.length === 1 ? (
                <div class="aspect-[4/3] overflow-hidden border border-primary-950/15">
                  <img src={collab.images[0].src} alt={collab.images[0].alt} loading="lazy" class="h-full w-full object-cover" />
                </div>
              ) : (
                <div class="grid grid-cols-2 gap-2">
                  {collab.images.slice(0, 4).map((img, j) => (
                    <div
                      class:list={[
                        'overflow-hidden border border-primary-950/15',
                        collab.images.length === 3 && j === 0 ? 'col-span-2 aspect-[2/1]' : 'aspect-square',
                      ]}
                    >
                      <img src={img.src} alt={img.alt} loading="lazy" class="h-full w-full object-cover" />
                    </div>
                  ))}
                </div>
              )}
            </div>
            <div class="lg:col-span-7">
              <div class="flex items-baseline gap-4">
                <span class="font-display text-sm font-semibold tabular-nums text-accent-orange">
                  {String(i + 1).padStart(2, '0')}
                </span>
                <span class="text-xs font-semibold uppercase tracking-[0.15em] text-primary-950/45">{collab.date}</span>
              </div>
              <h2 class="mt-3 font-display text-2xl font-bold tracking-tight text-primary-950">{collab.title}</h2>
              <p class="mt-4 leading-relaxed text-primary-950/70">{collab.description}</p>
            </div>
          </article>
        ))
      }
    </div>
  </section>
</BaseLayout>
