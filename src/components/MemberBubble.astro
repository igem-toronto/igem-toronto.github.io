---
interface Props {
  name: string;
  roles: string[];
  description: string;
  photo: string | null;
  linkedin?: string;
  website?: string;
  email?: string;
  index: number;
  variant?: 'hub' | 'node';
}

const {
  name,
  roles,
  description,
  photo,
  linkedin = '',
  website = '',
  email = '',
  index,
  variant = 'node',
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const photoSrc = photo ?? `${base}/images/placeholder-headshot.svg`;
const hasLinks = Boolean(linkedin.trim() || website.trim() || email.trim());
const dialogId = `member-dialog-${index}`;

const normalizeUrl = (url: string) => (url.startsWith('http') ? url : `https://${url}`);
// Strip the "PLACEHOLDER — " prefix for the small label, keep full text in modal.
const shortName = name.replace(/^PLACEHOLDER\s*[—-]\s*/, '');
---

<div class="group/node">
  <button
    type="button"
    class="block w-full cursor-pointer"
    data-open-dialog={dialogId}
    aria-haspopup="dialog"
    aria-label={`Read ${shortName}'s bio`}
  >
    <div
      class:list={[
        'relative aspect-square overflow-hidden rounded-full bg-primary-50 transition-all duration-300',
        variant === 'hub'
          ? 'border-2 border-accent-orange shadow-[0_0_0_4px_rgba(222,96,30,0.12)]'
          : 'border border-primary-950/25 group-hover/node:border-primary-950',
      ]}
    >
      <img
        src={photoSrc}
        alt={`Portrait of ${shortName}`}
        loading="lazy"
        class="h-full w-full object-cover grayscale transition duration-500 group-hover/node:grayscale-0"
        onerror={`this.src='${base}/images/placeholder-headshot.svg'; this.onerror=null;`}
      />
    </div>
    <div class="mt-2 text-center leading-tight">
      <p class:list={['font-display font-bold text-primary-950', variant === 'hub' ? 'text-sm' : 'text-[11px] sm:text-xs']}>
        {shortName}
      </p>
      <p class="mt-0.5 text-[9px] uppercase tracking-wider text-primary-950/50 sm:text-[10px]">{roles.join(' & ')}</p>
    </div>
  </button>
</div>

<dialog
  id={dialogId}
  class="m-auto w-11/12 max-w-lg border border-primary-950 bg-white p-0 shadow-xl backdrop:bg-primary-950/70"
>
  <div class="p-6 sm:p-8">
    <div class="flex items-start justify-between gap-4 border-b border-primary-950/15 pb-5">
      <div class="flex items-center gap-4">
        <img src={photoSrc} alt="" class="h-16 w-16 rounded-full object-cover grayscale" />
        <div>
          <h3 class="font-display text-lg font-bold text-primary-950">{name}</h3>
          <p class="mt-1 text-xs uppercase tracking-wider text-accent-orange">{roles.join(' / ')}</p>
        </div>
      </div>
      <button
        type="button"
        data-close-dialog={dialogId}
        aria-label="Close"
        class="p-1.5 text-primary-950/60 transition-colors hover:text-primary-950"
      >
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <path stroke-linecap="square" d="M6 6l12 12M18 6L6 18" />
        </svg>
      </button>
    </div>
    <p class="mt-5 leading-relaxed text-primary-950/80">{description}</p>
    {
      hasLinks && (
        <div class="mt-6 flex items-center gap-4 border-t border-primary-950/15 pt-5 text-primary-950/60">
          {linkedin.trim() && (
            <a href={normalizeUrl(linkedin.trim())} aria-label={`${shortName}'s LinkedIn`} class="transition-colors hover:text-accent-orange">
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 11-.001-4.124 2.062 2.062 0 010 4.124zM7.119 20.452H3.554V9h3.565v11.452z" />
              </svg>
            </a>
          )}
          {website.trim() && (
            <a href={normalizeUrl(website.trim())} aria-label={`${shortName}'s website`} class="transition-colors hover:text-accent-orange">
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                <circle cx="12" cy="12" r="9" />
                <path d="M3 12h18M12 3a15 15 0 010 18M12 3a15 15 0 000 18" />
              </svg>
            </a>
          )}
          {email.trim() && (
            <a href={`mailto:${email.trim()}`} aria-label={`Email ${shortName}`} class="transition-colors hover:text-accent-orange">
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                <rect x="2" y="4" width="20" height="16" />
                <path d="m2 7 10 6 10-6" />
              </svg>
            </a>
          )}
        </div>
      )
    }
  </div>
</dialog>
