---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import HistoryTimeline from '../components/HistoryTimeline.astro';
import MemberPie from '../components/MemberPie.astro';
import { allSeasons, summary } from '../lib/history';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const logoMarkUrl = `${base}/images/igem-toronto-mark-transparent.svg`;
const mailingListUrl =
  'https://docs.google.com/forms/d/e/1FAIpQLSf-KSquSPZU7TA7cn8uHiyXQrtfFgUsrA-pOTJUwozIr7L5TA/viewform';

// Counted rather than hardcoded, so the band cannot go stale the season we
// place again. iGEM records these as "Top 10 — <section>".
const topTenFinishes = allSeasons.filter((season) =>
  (season.awards ?? []).some((award) => award.startsWith('Top 10')),
).length;

// The current season, straight from history.json so the wiki link and copy
// cannot drift from the season page. Highlights come from the wiki's Project
// Description; rewrite them each season.
const season2026 = allSeasons.find((season) => season.year === 2026)!;
// The season's videos come from history.json too, so the home page and
// /history/2026/ always show the same ones.
const videoNote = {
  promo: 'Two minutes. The pitch for a general audience, made by Outreach.',
  presentation: 'Fourteen minutes. The Jamboree presentation: data, model, assays, bioreactor and results.',
  other: '',
};
const seasonVideos = (season2026.videos ?? []).map((video) => ({
  ...video,
  label: video.role === 'promo' ? 'Project promotion video' : video.role === 'presentation' ? 'Team presentation' : video.title,
  note: videoNote[video.role],
}));
const seasonHighlights = [
  {
    value: '307M',
    label: 'Enzyme sequences',
    text: 'PETadex: putative plastic-degrading enzymes recovered from 27.3 million public sequencing datasets, up from 495 known before.',
  },
  {
    value: '2',
    label: 'New assays',
    text: 'Copper-release biosensor and selection assays in E. coli that read out PET degradation at high throughput.',
  },
  {
    value: '$204',
    label: 'Per bioreactor',
    text: 'An open-source Arduino bioreactor with temperature control, OD600 readings and stirring, built to run in parallel.',
  },
];

const stats = [
  { value: String(summary.seasonsRegistered), label: 'Teams since 2005' },
  { value: String(summary.alumni), label: 'People on the team' },
  { value: String(summary.gold), label: 'Gold medals' },
  { value: String(topTenFinishes), label: 'Top 10 finishes' },
];
---

<BaseLayout title="Home">
  <!-- Hero -->
  <section class="relative flex min-h-[calc(100vh-4rem)] items-center overflow-hidden border-b border-primary-950 bg-primary-950 pb-28 sm:pb-30">
    <div
      class="pointer-events-none absolute inset-0 opacity-[0.12]"
      style="background-image: linear-gradient(to right, rgba(255,255,255,0.5) 1px, transparent 1px), linear-gradient(to bottom, rgba(255,255,255,0.5) 1px, transparent 1px); background-size: 72px 72px;"
      aria-hidden="true"
    >
    </div>
    <img
      src={logoMarkUrl}
      alt=""
      aria-hidden="true"
      class="pointer-events-none absolute left-1/2 top-1/2 h-[150%] w-auto max-w-none -translate-x-1/2 -translate-y-1/2 opacity-[0.05]"
    />
    <div class="pointer-events-none absolute inset-0" style="background: radial-gradient(ellipse at center, transparent 25%, rgba(10,30,43,0.7) 100%);" aria-hidden="true"></div>

    <div class="relative mx-auto w-full max-w-4xl px-4 text-center sm:px-6">
      <h1 class="font-display text-5xl font-bold leading-[1.05] tracking-tight text-white sm:text-6xl lg:text-7xl">
        Life is <em class="not-italic text-accent-teal">engineerable</em>
      </h1>
      <p class="mx-auto mt-8 max-w-2xl text-lg font-medium leading-relaxed text-white/85 sm:text-xl">
        University of Toronto's iGEM team
      </p>
      <p class="mx-auto mt-4 max-w-2xl text-lg leading-relaxed text-white/70 sm:text-xl">
        We apply synthetic biology to tackle pressing problems, and train the next generation of
        scientists to engineer these futures.
      </p>
      <div class="mt-12 flex flex-col items-center gap-4 sm:flex-row sm:justify-center">
        <a
          href={mailingListUrl}
          class="w-full border border-accent-gold bg-accent-gold px-8 py-3 text-sm font-semibold uppercase tracking-widest text-primary-950 transition-colors hover:bg-transparent hover:text-accent-gold sm:w-auto"
        >
          Join the Team
        </a>
        <a
          href="#what-we-do"
          class="w-full border border-white/30 px-8 py-3 text-sm font-semibold uppercase tracking-widest text-white transition-colors hover:border-white sm:w-auto"
        >
          Who Are We?
        </a>
      </div>
    </div>

    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 text-white/70" aria-hidden="true">
      <svg class="h-12 w-12 animate-bounce sm:h-14 sm:w-14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
        <path stroke-linecap="square" d="M12 4v15M5 12.5l7 7 7-7" />
      </svg>
    </div>
  </section>

  <!-- What we do -->
  <section id="what-we-do" class="mx-auto max-w-7xl scroll-mt-16 px-4 py-20 sm:px-6 lg:px-8">
    <div class="grid gap-x-16 gap-y-10 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <SectionHeading title="What we do" eyebrow="The team" number="01" />
        <img
          src={`${base}/images/home/team-best-therapeutics-2025-square.webp`}
          alt="iGEM Toronto team celebrating the Best Therapeutics Project award at the 2025 Grand Jamboree"
          loading="lazy"
          class="hidden aspect-square w-full border border-primary-950/15 object-cover lg:block"
        />
      </div>
      <div class="lg:col-span-8">
        <p class="text-lg leading-relaxed text-primary-950/80">
          Synthetic biology treats a living cell as something you can engineer. Give the cell new
          genetic instructions, and it can do a job it never evolved to do. Every winter, our team
          selects a global problem and spends the year trying to solve it — designing genetic
          constructs, modeling the outcomes, and testing the results. In November, we present our
          work at the iGEM Grand Jamboree, competing with teams from all around the world.
        </p>

        <div class="mt-12 grid gap-10 border-t border-primary-950/15 pt-10 sm:grid-cols-2">
          <div>
            <h3 class="font-display text-xl font-bold tracking-tight text-primary-950">
              The research is real...
            </h3>
            <p class="mt-3 leading-relaxed text-primary-950/70">
              Past teams have tackled antibiotic resistance, landfill emissions, invasive tree
              diseases, contaminated mine tailings, and industrial plastic waste. Our work produces
              tangible results, with members having gone on to publish their research or spin out
              their projects into startups.
            </p>
          </div>
          <div>
            <h3 class="font-display text-xl font-bold tracking-tight text-primary-950">
              so is the training
            </h3>
            <p class="mt-3 leading-relaxed text-primary-950/70">
              Most members arrive with little to no research experience, but leave as confident
              scientists who have completed the full cycle of designing, building, and testing.
              Whether they move into computational modeling or wet lab research, the skills they
              build here form the foundation of their careers.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- This season -->
  <section class="border-t border-primary-950/15 bg-white">
    <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8">
      <div class="grid gap-x-16 gap-y-10 lg:grid-cols-12">
        <div class="lg:col-span-4">
          <SectionHeading title="PetaBite" eyebrow="2026 season" number="02" />
          <p class="text-lg leading-relaxed text-primary-950/80">
            Nature has already evolved enzymes for almost every condition on Earth. This year we built a
            workflow to find the ones that eat PET plastic at room temperature, so wastewater plants could
            use them without heating anything.
          </p>
          <div class="mt-8 flex flex-col items-start gap-3">
            <a
              href={season2026.wikiUrl}
              class="inline-flex items-center gap-3 border border-accent-gold bg-accent-gold px-8 py-4 text-sm font-semibold uppercase tracking-widest text-primary-950 transition-colors hover:bg-transparent hover:text-accent-gold-deep"
            >
              Read the wiki
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="square" d="M5 12h14M13 6l6 6-6 6" />
              </svg>
            </a>
            <a
              href={season2026.teamsUrl}
              class="inline-flex items-center gap-3 border border-primary-950/30 px-8 py-4 text-sm font-semibold uppercase tracking-widest text-primary-950 transition-colors hover:border-primary-950"
            >
              Team page on igem.org
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="square" d="M5 12h14M13 6l6 6-6 6" />
              </svg>
            </a>
          </div>
        </div>
        <div class="lg:col-span-8">
          <div class="grid gap-px border border-primary-950/10 bg-primary-950/10 sm:grid-cols-3">
            {
              seasonHighlights.map((item) => (
                <div class="bg-white p-6">
                  <div class="font-display text-3xl font-bold tabular-nums text-primary-950">{item.value}</div>
                  <div class="mt-1 text-xs font-medium uppercase tracking-[0.15em] text-primary-950/50">
                    {item.label}
                  </div>
                  <p class="mt-4 text-sm leading-relaxed text-primary-950/70">{item.text}</p>
                </div>
              ))
            }
          </div>
          <div class="mt-8 grid gap-6 sm:grid-cols-2">
            {
              seasonVideos.map((video) => (
                <figure>
                  <div class="aspect-video border border-primary-950/15 bg-primary-950">
                    <iframe
                      title={video.title}
                      src={`${video.embedUrl}?p2p=0`}
                      class="h-full w-full"
                      loading="lazy"
                      allowfullscreen
                      sandbox="allow-same-origin allow-scripts allow-popups allow-forms"
                    />
                  </div>
                  <figcaption class="mt-3">
                    <p class="font-display font-bold text-primary-950">{video.label}</p>
                    <p class="mt-1 text-sm text-primary-950/60">{video.note}</p>
                  </figcaption>
                </figure>
              ))
            }
          </div>
          <p class="mt-6 text-sm text-primary-950/60">
            Activity data from the assays and the bioreactor feed back into the model, so each round of
            testing improves the next round of candidates.
            <a href={`${base}/history/2026/`} class="ml-1 underline decoration-primary-950/30 underline-offset-4 hover:text-primary-950">
              The season in brief.
            </a>
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Record -->
  <section class="border-y border-primary-950/15 bg-primary-50">
    <div class="mx-auto max-w-7xl px-4 py-14 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 gap-y-10 text-center sm:grid-cols-4">
        {
          stats.map((stat) => (
            <div>
              <div class="font-display text-4xl font-bold tabular-nums text-primary-950 sm:text-5xl">
                {stat.value}
              </div>
              <div class="mt-2 text-xs font-medium uppercase tracking-[0.15em] text-primary-950/50">
                {stat.label}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Gallery CTA -->
  <section class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8">
    <a
      href={base + '/gallery/'}
      class="flex flex-col items-start justify-between gap-6 border border-primary-950 bg-primary-950 px-8 py-10 transition-colors hover:bg-primary-950/90 sm:flex-row sm:items-center"
    >
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.25em] text-accent-teal">In practice</p>
        <h2 class="mt-2 font-display text-2xl font-bold tracking-tight text-white sm:text-3xl">
          Bench work, teaching, outreach, the Jamboree
        </h2>
        <p class="mt-2 max-w-xl text-white/60">
          Two decades of it, recovered from the team's own archive and browsable by year or category.
        </p>
      </div>
      <span class="inline-flex shrink-0 items-center gap-3 border border-accent-gold bg-accent-gold px-8 py-4 text-sm font-semibold uppercase tracking-widest text-primary-950 transition-colors">
        Explore the gallery
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="square" d="M5 12h14M13 6l6 6-6 6" />
        </svg>
      </span>
    </a>
  </section>

  <!-- Track record -->
  <section class="border-y border-primary-950/15 bg-primary-50">
    <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8">
      <SectionHeading
        title="Every team since 2005"
        eyebrow="Track record"
        number="03"
        subtitle="A different problem every year, including the years the record is incomplete. Select a year for the short version, then open it for the project, the awards and the photographs that survive."
      />
      <HistoryTimeline />

      <div class="mt-12 border-t border-primary-950/15 pt-8">
        <a
          href={base + '/history/'}
          class="inline-flex items-center gap-3 border border-accent-gold bg-accent-gold px-8 py-4 text-sm font-semibold uppercase tracking-widest text-primary-950 transition-colors hover:bg-transparent hover:text-accent-gold-deep"
        >
          The full history
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="square" d="M5 12h14M13 6l6 6-6 6" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Who we are -->
  <section class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8">
    <div class="grid gap-x-16 gap-y-10 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <SectionHeading
          title="Who we are"
          eyebrow="The divisions"
          number="04"
          subtitle="Wet lab, dry lab, hardware, human practices, outreach, venture and web. You don't need a biology degree to make an impact here, and a lot of the team does not have one. Select a slice to learn more about that division."
        />
        <a
          href={base + '/divisions/'}
          class="mt-8 inline-flex items-center gap-3 border border-accent-gold bg-accent-gold px-8 py-4 text-sm font-semibold uppercase tracking-widest text-primary-950 transition-colors hover:bg-transparent hover:text-accent-gold-deep"
        >
          All divisions
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="square" d="M5 12h14M13 6l6 6-6 6" />
          </svg>
        </a>
      </div>
      <div class="lg:col-span-8">
        <MemberPie />
      </div>
    </div>
  </section>

  <!-- CTA band -->
  <section class="bg-primary-950">
    <div class="mx-auto flex max-w-7xl flex-col items-start justify-between gap-6 px-4 py-16 sm:px-6 md:flex-row md:items-center lg:px-8">
      <div>
        <h2 class="font-display text-2xl font-bold tracking-tight text-white sm:text-3xl">
          Applications open every January
        </h2>
        <p class="mt-2 max-w-xl text-white/60">
          Whether you pipette, code, build or write, there is a place for you on the team. Join the
          mailing list and you will be the first to know when recruitment opens.
        </p>
      </div>
      <a
        href={mailingListUrl}
        class="shrink-0 border border-accent-gold bg-accent-gold px-7 py-3 text-sm font-semibold uppercase tracking-widest text-primary-950 transition-colors hover:bg-transparent hover:text-accent-gold"
      >
        Join the Mailing List
      </a>
    </div>
  </section>
</BaseLayout>
