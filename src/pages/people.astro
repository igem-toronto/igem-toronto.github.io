---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import MemberBubble from '../components/MemberBubble.astro';
import team from '../data/team.json';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Members are grouped by the `group` field, in the order defined in team.json.
// Leads/directors/presidents are sorted to the front of each group.
const leadPriority = (roles: string[]) =>
  roles.some((r) => /president|director/i.test(r)) ? 0 : roles.some((r) => /lead/i.test(r)) ? 1 : 2;

const isLead = (roles: string[]) => leadPriority(roles) < 2;

// A member's `group` is their primary section, but their `roles` often name a
// second division (e.g. "Venture Lead", "Web Lead"). Surface them under every
// group their roles point to, not just the primary one.
const stripLeadSuffix = (role: string) => role.replace(/\s+(co-)?lead$/i, '').trim();

const groupsFor = (member: (typeof team.members)[number]) => {
  const groups = new Set([member.group]);
  for (const role of member.roles) {
    const matched = stripLeadSuffix(role);
    if (team.groups.includes(matched)) groups.add(matched);
  }
  return groups;
};

const grouped = team.groups
  .map((group) => ({
    group,
    members: team.members
      .filter((m) => groupsFor(m).has(group))
      .sort((a, b) => leadPriority(a.roles) - leadPriority(b.roles)),
  }))
  .filter(({ members }) => members.length > 0);

let cardIndex = 0;
---

<BaseLayout title="People" description="Meet the people behind iGEM Toronto.">
  <PageHeader
    eyebrow="The Team"
    title="People"
    lede="The scientists, engineers, and communicators behind iGEM Toronto."
  />

  <!-- Team photo -->
  <section class="mx-auto max-w-7xl px-4 pt-14 sm:px-6 lg:px-8">
    <!--
      No full-roster photograph of the 2026 team exists yet. This is the widest
      team shot in the gallery (Riverdale Park social, spring 2026). Swap the
      file when a full team photo is taken; see docs/UPDATING_THE_TEAM.md.
    -->
    <figure>
      <img
        src={`${base}/images/history/2026/park-evening-group-wide-1.webp`}
        alt="iGEM Toronto 2026 team members on the grass at an evening park social"
        class="aspect-[2/1] w-full border border-primary-950/15 object-cover object-center"
      />
      <figcaption class="mt-3 text-xs uppercase tracking-[0.15em] text-primary-950/45">
        The 2026 team, Riverdale Park, spring 2026
      </figcaption>
    </figure>
  </section>

  <!-- Team grids -->
  <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
    <div class="space-y-14">
      {
        grouped.map(({ group, members }, i) => (
          <div>
            <div class="mb-8 flex items-baseline gap-4 border-b border-primary-950/15 pb-4">
              <span class="font-display text-sm font-semibold tabular-nums text-accent-gold-deep">
                {String(i + 1).padStart(2, '0')}
              </span>
              <h2 class="font-display text-2xl font-bold tracking-tight text-primary-950" id={group.toLowerCase().replace(/\s+/g, '-')}>
                {group}
              </h2>
              <span class="text-sm text-primary-950/40">({members.length})</span>
            </div>
            <div class="grid grid-cols-3 gap-x-5 gap-y-8 sm:grid-cols-4 md:grid-cols-5 lg:grid-cols-6 xl:grid-cols-7">
              {members.map((member) => (
                <MemberBubble
                  name={member.name}
                  roles={member.roles}
                  description={member.description}
                  photo={member.photo}
                  linkedin={member.linkedin}
                  website={member.website}
                  email={member.email}
                  index={cardIndex++}
                  variant={isLead(member.roles) ? 'hub' : 'node'}
                />
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </section>
</BaseLayout>

<script>
  document.querySelectorAll<HTMLElement>('[data-open-dialog]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const dialog = document.getElementById(btn.dataset.openDialog!) as HTMLDialogElement | null;
      dialog?.showModal();
    });
  });

  document.querySelectorAll<HTMLElement>('[data-close-dialog]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const dialog = document.getElementById(btn.dataset.closeDialog!) as HTMLDialogElement | null;
      dialog?.close();
    });
  });

  document.querySelectorAll('dialog').forEach((dialog) => {
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });
  });
</script>
