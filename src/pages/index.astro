---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import HistoryTimeline from '../components/HistoryTimeline.astro';
import MemberPie from '../components/MemberPie.astro';

const logoMarkUrl = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/images/logo-mark.png`;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const mailingListUrl =
  'https://docs.google.com/forms/d/e/1FAIpQLSf-KSquSPZU7TA7cn8uHiyXQrtfFgUsrA-pOTJUwozIr7L5TA/viewform';
---

<BaseLayout title="Home">
  <!-- Hero: full-screen, logo + tagline + actions -->
  <section class="relative flex min-h-[calc(100vh-4rem)] items-center overflow-hidden border-b border-primary-950 bg-primary-950">
    <!-- Fine engineering grid -->
    <div
      class="pointer-events-none absolute inset-0 opacity-[0.12]"
      style="background-image: linear-gradient(to right, rgba(255,255,255,0.5) 1px, transparent 1px), linear-gradient(to bottom, rgba(255,255,255,0.5) 1px, transparent 1px); background-size: 72px 72px;"
      aria-hidden="true"
    >
    </div>
    <!-- Actual logo as a large, faint backdrop watermark -->
    <img
      src={logoMarkUrl}
      alt=""
      aria-hidden="true"
      class="pointer-events-none absolute left-1/2 top-1/2 h-[85%] w-auto max-w-none -translate-x-1/2 -translate-y-1/2 opacity-[0.06]"
    />
    <!-- Vignette for depth -->
    <div class="pointer-events-none absolute inset-0" style="background: radial-gradient(ellipse at center, transparent 25%, rgba(10,30,43,0.7) 100%);" aria-hidden="true"></div>

    <div class="relative mx-auto flex w-full max-w-4xl flex-col items-center px-4 text-center sm:px-6">
      <p class="font-display text-2xl font-medium leading-snug tracking-tight text-white sm:text-3xl lg:text-4xl">
        The future of <em class="not-italic text-accent-orange-light">synthetic biology</em>, at Canada's <em class="not-italic text-primary-200">best</em> university.
      </p>
      <div class="mt-12 flex flex-col items-center gap-4 sm:flex-row">
        <a
          href={mailingListUrl}
          class="w-full border border-accent-orange bg-accent-orange px-8 py-3 text-sm font-semibold uppercase tracking-widest text-white transition-colors hover:bg-transparent sm:w-auto"
        >
          Join the Mailing List
        </a>
        <a
          href={base + '/people/'}
          class="w-full border border-white/30 px-8 py-3 text-sm font-semibold uppercase tracking-widest text-white transition-colors hover:border-white sm:w-auto"
        >
          Meet the Team
        </a>
      </div>
    </div>

    <!-- Scroll cue -->
    <div class="absolute bottom-6 left-1/2 -translate-x-1/2 text-white/40" aria-hidden="true">
      <svg class="h-6 w-6 animate-bounce" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <path stroke-linecap="square" d="M12 5v14M6 13l6 6 6-6" />
      </svg>
    </div>
  </section>

  <!-- About -->
  <section class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8">
    <div class="grid gap-x-16 gap-y-10 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <SectionHeading title="About the team" eyebrow="Overview" number="01" />
      </div>
      <div class="space-y-6 text-lg leading-relaxed text-primary-950/80 lg:col-span-8">
        <p>
          iGEM Toronto is a team at the forefront of synthetic biology research and innovation. As participants in the
          International Genetically Engineered Machine (iGEM) competition, we tackle global challenges through the
          application of cutting-edge biological solutions, fostering creativity, collaboration, and scientific
          excellence.
        </p>
        <p>
          We have represented the University of Toronto since 2005, spanning wet lab research, computational
          modelling, hardware, human practices, and entrepreneurship. Twenty-one seasons have produced six gold
          medals, three silver, four bronze, and a run of special prizes that includes back-to-back Top 10
          finishes in 2024 and 2025.
        </p>
      </div>
    </div>
  </section>

  <!-- Track record -->
  <section class="border-y border-primary-950/15 bg-primary-50">
    <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8">
      <SectionHeading
        title="Our track record"
        eyebrow="Competition history"
        number="02"
        subtitle="Every season since 2005, including the years the record is incomplete. Select a year for the short version, then open it for the project, the awards, and the photographs that survive."
      />
      <HistoryTimeline />

      <div class="mt-12 border-t border-primary-950/15 pt-8">
        <a
          href={base + '/history/'}
          class="inline-flex items-center gap-2 text-sm font-semibold uppercase tracking-widest text-accent-orange transition-colors hover:text-primary-950"
        >
          The full history
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="square" d="M5 12h14M13 6l6 6-6 6" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Who we are -->
  <section class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8">
    <div class="grid gap-x-16 gap-y-10 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <SectionHeading
          title="Who we are"
          eyebrow="The team"
          number="03"
          subtitle="Students from across the university, organized into divisions that each own a part of the project. Select a slice to meet that division."
        />
        <a
          href={base + '/divisions/'}
          class="inline-flex items-center gap-2 text-sm font-semibold uppercase tracking-widest text-accent-orange transition-colors hover:text-primary-950"
        >
          All divisions
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="square" d="M5 12h14M13 6l6 6-6 6" />
          </svg>
        </a>
      </div>
      <div class="lg:col-span-8">
        <MemberPie />
      </div>
    </div>
  </section>

  <!-- CTA band -->
  <section class="bg-primary-950">
    <div class="mx-auto flex max-w-7xl flex-col items-start justify-between gap-6 px-4 py-16 sm:px-6 md:flex-row md:items-center lg:px-8">
      <div>
        <h2 class="font-display text-2xl font-bold tracking-tight text-white sm:text-3xl">Interested in joining?</h2>
        <p class="mt-2 max-w-xl text-white/60">
          Whether you pipette, code, build, or communicate — there is a place for you on the team.
        </p>
      </div>
      <a
        href={mailingListUrl}
        class="shrink-0 border border-accent-orange bg-accent-orange px-7 py-3 text-sm font-semibold uppercase tracking-widest text-white transition-colors hover:bg-transparent"
      >
        Join the Mailing List
      </a>
    </div>
  </section>
</BaseLayout>
