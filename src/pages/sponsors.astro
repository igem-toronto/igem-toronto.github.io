---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';

// The 2026 sponsor list, mirrored from the competition wiki
// (iGEM_wiki/src/data/sponsors.js). Logos are the wiki's AVIF files on the
// iGEM CDN; a sponsor with `logo: null` renders its name instead.
// See docs/UPDATING_THE_TEAM.md section 3.
const LOGOS = 'https://static.igem.wiki/teams/6187/wiki/sponsor-logos';
const tiers = [
  {
    name: 'University of Toronto',
    sponsors: [
      { name: 'RNAlab', href: 'https://www.rnalab.ca/', logo: `${LOGOS}/sponsor-rnalab.avif` },
      { name: 'CAGEF', href: 'https://cagef.utoronto.ca/', logo: `${LOGOS}/sponsor-cagef.avif` },
      { name: 'Ecology & Evolutionary Biology', href: 'https://eeb.utoronto.ca/', logo: `${LOGOS}/sponsor-eeb.avif` },
      { name: 'Cell & Systems Biology', href: 'https://csb.utoronto.ca/', logo: `${LOGOS}/sponsor-csb.avif` },
      { name: 'Human Biology Program', href: 'https://hmb.utoronto.ca/', logo: null },
      { name: 'ASSU', href: 'https://assu.ca/', logo: `${LOGOS}/sponsor-assu.avif` },
      { name: 'U of T Trash Team', href: 'https://uofttrashteam.ca/', logo: `${LOGOS}/sponsor-trash-team.avif` },
    ],
  },
  {
    name: 'Industry partners',
    sponsors: [
      { name: 'Twist Bioscience', href: 'https://www.twistbioscience.com/', logo: `${LOGOS}/sponsor-twist.avif` },
      { name: 'New England Biolabs', href: 'https://www.neb.ca/', logo: `${LOGOS}/sponsor-neb.avif` },
      { name: 'Integrated DNA Technologies', href: 'https://www.idtdna.com/', logo: `${LOGOS}/sponsor-idt.avif` },
      { name: 'SnapGene', href: 'https://www.snapgene.com/', logo: `${LOGOS}/sponsor-snapgene.avif` },
      { name: 'BioRender', href: 'https://www.biorender.com/', logo: `${LOGOS}/sponsor-biorender.avif` },
    ],
  },
  {
    name: 'Community sponsors',
    sponsors: [
      { name: 'Fraser River Junk Removal', href: 'https://frjunk.ca/', logo: `${LOGOS}/sponsor-frjunk.avif` },
      { name: 'Awesome Foundation Toronto', href: 'https://www.awesomefoundation.org/en/chapters/toronto', logo: `${LOGOS}/sponsor-awesome-foundation.avif` },
      { name: "Longo's", href: 'https://www.longos.com/', logo: `${LOGOS}/sponsor-longos.avif` },
      { name: 'Jukebox', href: 'https://www.jukeboxprint.com/', logo: `${LOGOS}/sponsor-jukebox.avif` },
      { name: 'Quokka Prints', href: 'https://quokkaprints.com/', logo: `${LOGOS}/sponsor-quokka.avif` },
    ],
  },
];
---

<BaseLayout title="Sponsors" description="The sponsors who support iGEM Toronto.">
  <PageHeader
    eyebrow="Support"
    title="Sponsors"
    lede="Seventeen institutional and community sponsors backed the 2026 season, the most in iGEM Toronto's history. Their support paid for the DNA, the reagents, the hardware and the trip to the Jamboree."
  />

  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:px-8">
    <div class="space-y-14">
      {
        tiers.map((tier, i) => (
          <div>
            <div class="mb-6 flex items-baseline gap-4 border-b border-primary-950/15 pb-4">
              <span class="font-display text-sm font-semibold tabular-nums text-accent-gold-deep">
                {String(i + 1).padStart(2, '0')}
              </span>
              <h2 class="font-display text-xl font-bold tracking-tight text-primary-950">{tier.name}</h2>
            </div>
            <div class="grid grid-cols-2 gap-px border border-primary-950/10 bg-primary-950/10 sm:grid-cols-3 lg:grid-cols-4">
              {tier.sponsors.map((sponsor) => (
                <a
                  href={sponsor.href}
                  class="flex h-36 items-center justify-center bg-white p-6 transition-colors hover:bg-primary-50"
                  aria-label={sponsor.name}
                >
                  {sponsor.logo ? (
                    <img src={sponsor.logo} alt={sponsor.name} class="max-h-full max-w-full object-contain" loading="lazy" />
                  ) : (
                    <span class="text-center font-display text-sm font-semibold text-primary-950">{sponsor.name}</span>
                  )}
                </a>
              ))}
            </div>
          </div>
        ))
      }
    </div>

    <div class="mt-16 flex flex-col items-start justify-between gap-6 border border-primary-950 bg-primary-950 px-8 py-10 md:flex-row md:items-center">
      <div>
        <h2 class="font-display text-2xl font-bold tracking-tight text-white">Interested in sponsoring us?</h2>
        <p class="mt-2 max-w-xl text-white/60">
          Support the next generation of synthetic biologists at the University of Toronto.
        </p>
      </div>
      <a
        href="mailto:igem@g.skule.ca"
        class="shrink-0 border border-accent-gold bg-accent-gold px-7 py-3 text-sm font-semibold uppercase tracking-widest text-primary-950 transition-colors hover:bg-transparent hover:text-accent-gold"
      >
        Get in Touch
      </a>
    </div>
  </section>
</BaseLayout>
