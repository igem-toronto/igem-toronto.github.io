---
/**
 * The home page competition timeline: one tab per season, 2005 to the present.
 *
 * Panels stay deliberately short — a medal, a track, one sentence, three
 * photographs. Everything else (the full award list, the story, the whole
 * gallery) lives on the season page behind "Learn more".
 */
import PhotoStrip from './PhotoStrip.astro';
import { allSeasons, ledgerStats, medalClass, medalLabel, projectLabel, seasonUrl } from '../lib/history';

const stats = ledgerStats();
---

<div>
  <!-- Summary ledger -->
  <div class="grid grid-cols-2 divide-x divide-y divide-primary-950/10 border border-primary-950/10 sm:grid-cols-4 sm:divide-y-0">
    {
      stats.map((stat) => (
        <div class="px-6 py-8">
          <div class="font-display text-3xl font-bold tabular-nums text-primary-950">{stat.value}</div>
          <div class="mt-2 text-xs font-medium uppercase tracking-[0.15em] text-primary-950/50">{stat.label}</div>
        </div>
      ))
    }
  </div>

  <!-- Year rail. 21 seasons is wider than any phone, so it scrolls; the gradient
       masks on either side are the affordance that says so. -->
  <div class="relative mt-12">
    <div
      class="pointer-events-none absolute inset-y-0 left-0 z-10 w-8 bg-gradient-to-r from-primary-50 to-transparent"
      aria-hidden="true"
    >
    </div>
    <div
      class="pointer-events-none absolute inset-y-0 right-0 z-10 w-8 bg-gradient-to-l from-primary-50 to-transparent"
      aria-hidden="true"
    >
    </div>

    <div class="border-b border-primary-950/15" role="tablist" aria-label="Competition seasons">
      <div class="-mb-px flex gap-1 overflow-x-auto scroll-smooth" data-year-rail>
        {
          allSeasons.map((season, i) => (
            <button
              type="button"
              role="tab"
              id={`year-tab-${season.year}`}
              data-year-tab={season.year}
              aria-controls={`year-panel-${season.year}`}
              aria-selected={i === 0 ? 'true' : 'false'}
              tabindex={i === 0 ? 0 : -1}
              class:list={[
                'shrink-0 border-b-2 px-4 py-3 font-display text-lg font-bold tabular-nums transition-colors',
                i === 0
                  ? 'border-accent-orange text-primary-950'
                  : 'border-transparent text-primary-950/40 hover:text-primary-950/80',
              ]}
            >
              {season.year}
            </button>
          ))
        }
      </div>
    </div>
  </div>

  <!-- Year panels -->
  {
    allSeasons.map((season, i) => (
      <div
        role="tabpanel"
        id={`year-panel-${season.year}`}
        data-year-panel={season.year}
        aria-labelledby={`year-tab-${season.year}`}
        hidden={i !== 0}
        class="pt-10"
      >
        <div class="grid gap-x-12 gap-y-8 lg:grid-cols-12">
          <div class="lg:col-span-7">
            <div class="flex flex-wrap items-center gap-2">
              <span
                class:list={[
                  'border px-2.5 py-1 text-xs font-semibold uppercase tracking-[0.15em]',
                  medalClass(season.medal),
                ]}
              >
                {medalLabel(season)}
              </span>
              {season.track && (
                <span class="border border-primary-950/20 px-2.5 py-1 text-xs font-semibold uppercase tracking-[0.15em] text-primary-950/55">
                  {season.track}
                </span>
              )}
              <span class="border border-primary-950/20 px-2.5 py-1 text-xs font-semibold uppercase tracking-[0.15em] text-primary-950/55">
                {season.teamSize} members
              </span>
            </div>

            <h3 class="mt-5 font-display text-2xl font-bold tracking-tight text-primary-950">
              {projectLabel(season)}
            </h3>
            <p class="mt-4 leading-relaxed text-primary-950/70">{season.blurb}</p>

            <div class="mt-7 flex flex-wrap items-center gap-x-6 gap-y-3">
              <a
                href={seasonUrl(season.year)}
                class="inline-flex items-center gap-2 border border-accent-orange bg-accent-orange px-6 py-2.5 text-sm font-semibold uppercase tracking-widest text-white transition-colors hover:bg-transparent hover:text-accent-orange"
              >
                Learn more
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path stroke-linecap="square" d="M5 12h14M13 6l6 6-6 6" />
                </svg>
              </a>
              {season.awards.length > 0 && (
                <span class="text-sm text-primary-950/55">
                  + {season.awards.length} special {season.awards.length === 1 ? 'award' : 'awards'}
                </span>
              )}
            </div>
          </div>

          <div class="lg:col-span-5">
            <PhotoStrip year={season.year} />
          </div>
        </div>
      </div>
    ))
  }
</div>

<script>
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-year-tab]'));
  const panels = document.querySelectorAll<HTMLElement>('[data-year-panel]');

  const select = (tab: HTMLButtonElement, focus = false) => {
    tabs.forEach((other) => {
      const active = other === tab;
      other.setAttribute('aria-selected', String(active));
      other.tabIndex = active ? 0 : -1;
      other.classList.toggle('border-accent-orange', active);
      other.classList.toggle('text-primary-950', active);
      other.classList.toggle('border-transparent', !active);
      other.classList.toggle('text-primary-950/40', !active);
      other.classList.toggle('hover:text-primary-950/80', !active);
    });

    panels.forEach((panel) => {
      panel.hidden = panel.dataset.yearPanel !== tab.dataset.yearTab;
    });

    tab.scrollIntoView({ block: 'nearest', inline: 'nearest' });
    if (focus) tab.focus();
  };

  tabs.forEach((tab, index) => {
    tab.addEventListener('click', () => select(tab));

    // With 21 tabs the rail is long enough that arrow keys stop being a nicety.
    tab.addEventListener('keydown', (event) => {
      const step = event.key === 'ArrowRight' ? 1 : event.key === 'ArrowLeft' ? -1 : 0;
      if (step === 0) return;
      event.preventDefault();
      select(tabs[(index + step + tabs.length) % tabs.length], true);
    });
  });
</script>
